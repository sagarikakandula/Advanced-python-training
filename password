# password strong or weak
a = input("enter your password ")
up,lw,dg,sp = 0,0,0,0
if (len(a)>7):
    for i in a:
        if i.isupper():
            up += 1
        elif i.islower():
            lw += 1
        elif i.isdigit():
            dg += 1
        else:
            sp += 1
    if(up > 0 and lw > 0 and dg > 0 and sp > 0):
        print("strong")
    else:
        print("weak")
else:
    print("weak cuz no minimium char")
            
